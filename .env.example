# Copy this file to .env in the repository root and fill in the empty values.
# Docker Compose reads this file's local .env copy; never commit real credentials.
DB_USER=languageapp_user
DB_PASSWORD=
DB_NAME=language_learning_db

# Required: generate your own Base64-encoded random key (64 bytes recommended).
# See README for the PowerShell command. This is NOT an OAuth client secret.
JWT_SECRET=

# Public compatibility value; must match app.security.exercise-salt in the backend.
# This value is included in the frontend build; it is not a security secret.
VITE_APP_SECURITY_EXERCISE_SALT=L4ngu4ge4ppS3cr3tS4lt2026!

# Mailtrap sandbox defaults; obtain sandbox credentials separately.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Canonical browser origin for the included Docker Compose HTTPS setup.
FRONTEND_URL=https://localhost
# OAuth entry point and provider callback host for this local setup.
OAUTH_AUTHORIZATION_BASE_URL=http://localhost:8080

# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Register the callback URLs listed in README with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
